{
  "schema_version": 1,
  "policy_id": "software-mppg-governance",
  "normative": false,
  "derived_from": {
    "path": "governance/MPPG_PROMPT_MASTER_CANONICO.md",
    "sha256": "3f3997c771c0b579089598787b9cedd85ba6749a1dab1c3724e212f50052896d",
    "rule": "The Prompt Master is authoritative. This JSON is only a machine-readable derivative and must never override it."
  },
  "repository": {
    "root": "/home/gustavodetarso/Documentos/mppg",
    "branch": "master",
    "upstream": "origin/master",
    "canonical_software_prefix": "software/academic_pipeline_mppg/",
    "historical_structural_baseline": "4af458e969c672964f1d3043f95a41386f25c825",
    "operational_head_rule": "resolve_readonly_each_front_never_hardcode"
  },
  "authority_order": [
    "MPPG_PROMPT_MASTER_CANONICO.md",
    "FRONT_AUTHORITY_LEDGER and frozen front contracts",
    "front-specific prompt compatible with master",
    "structured technical evidence",
    "live repository state from read-only audit",
    "live tests/entrypoints/config/imports/consumers/producers",
    "explicit user approval for subjective product criteria when applicable",
    "Git history",
    "historical documentation"
  ],
  "automatic_readonly": [
    "inventory",
    "audit",
    "evidence_reading",
    "semantic_adjudication",
    "reference_search",
    "AST_analysis",
    "lexical_analysis",
    "reachability_analysis",
    "blob_and_hash_comparison",
    "solution_design",
    "contract_freeze",
    "read_only_script_preparation_and_validation",
    "post_materialization_audit",
    "post_commit_audit",
    "post_publication_audit",
    "global_closure_audit",
    "safe_representative_preview_generation",
    "objective_product_analysis",
    "human_acceptance_preparation"
  ],
  "explicit_authorization_required": [
    "real_file_mutation",
    "tracked_file_creation",
    "removal_or_retirement",
    "rename_or_move",
    ".env_mutation",
    "persistent_database_mutation",
    "git_add",
    "commit",
    "amend",
    "push",
    "tag",
    "merge",
    "rebase",
    "cherry_pick",
    "branch_or_worktree_mutation",
    "reset",
    "restore",
    "clean",
    "ref_mutation",
    "publication"
  ],
  "git": {
    "exact_staging_required": true,
    "git_add_dot_prohibited_for_governed_flows": true,
    "force_push_prohibited": true,
    "force_with_lease_prohibited": true,
    "publication_rule": "single_ref_fast_forward_non_force",
    "stage_commit_publication_authorizations_are_separate": true,
    "cached_diff_check_required": true,
    "temporary_candidate_index_preferred_when_appropriate": true,
    "byte_exact_index_rollback_on_post_staging_failure": true
  },
  "protected_state": {
    "root_env": "byte_exact_preservation_unless_explicitly_authorized",
    "canonical_software_untracked": "blocker",
    "external_untracked": "preserve_and_compare_intra_run_with_byte_safe_fingerprint"
  },
  "front_required_contracts": [
    "FRONT_CLASS",
    "CLOSURE_APPLICABILITY_MATRIX",
    "ARTIFACT_ROLE_MAP"
  ],
  "conditional_contracts": [
    "TEST_UNIVERSE_CONTRACT",
    "PRODUCT_ACCEPTANCE_CONTRACT",
    "USER_ACCEPTANCE_CONTRACT"
  ],
  "blocker_domains": [
    "software",
    "repository_state",
    "environment",
    "authorization",
    "test",
    "product_acceptance",
    "user_acceptance",
    "external_dependency",
    "auditor_harness",
    "evidence_packaging",
    "authority_model",
    "scanner_model",
    "unknown"
  ],
  "harness": {
    "complex_auditors_self_contained": true,
    "authority_manifest_required": true,
    "self_test_required": true,
    "syntax_or_ast_validation_required": true,
    "sha256_required": true,
    "copyable_command_required": true,
    "closure_audits_non_fail_fast": true,
    "rebuild_after_two_consecutive_harness_only_failures": true
  },
  "product_acceptance": {
    "user_acceptance_required_for_user_perceptible_changes_by_default": true,
    "sequence": [
      "TECHNICAL_VALIDATION",
      "MACHINE_PRODUCT_ACCEPTANCE",
      "USER_ACCEPTANCE",
      "FRONT_CLOSURE"
    ],
    "ai_must_not_self_approve_user_acceptance": true,
    "product_acceptance_is_not_git_authorization": true,
    "derivation": {
      "mode": "fail_closed",
      "perceptible_role_markers": [
        "normative_authority",
        "documentation_current",
        "operational_contract_documentation",
        "document",
        "pdf",
        "docx",
        "html",
        "dashboard",
        "chart",
        "report",
        "interface",
        "template",
        "state_template",
        "generation_prompt",
        "prompt",
        "ai_content",
        "user_perceptible_output",
        "product_artifact"
      ],
      "default_user_acceptance_required_when_perceptible": true,
      "default_product_artifact_required_when_perceptible": true,
      "false_override_requires_explicit_contractual_justification": true,
      "false_override_requires_authority": true,
      "ai_must_not_author_exception": true,
      "ai_must_not_self_approve_user_acceptance": true
    },
    "staging_precondition": {
      "when_user_acceptance_required": "TECHNICAL_POST_MATERIALIZATION=PASS AND MACHINE_PRODUCT_ACCEPTANCE=PASS AND USER_ACCEPTANCE=PASS",
      "deferred_exception": "Only when USER_ACCEPTANCE_DEFERRED_TO_PUBLISHED_RUNTIME=true is explicitly justified and frozen in the front contract."
    },
    "closure_formula": "FRONT_CLOSED = TECHNICAL_CLOSURE_PASS AND MACHINE_PRODUCT_ACCEPTANCE_PASS AND USER_ACCEPTANCE_PASS_WHEN_REQUIRED AND ZERO_APPLICABLE_BLOCKERS",
    "pending_disposition": {
      "technical_gates": "PASS",
      "user_acceptance": "PENDING",
      "front_progress": "AWAITING_USER_ACCEPTANCE",
      "front_closed": false
    }
  },
  "progress": [
    "SOFTWARE_STATE_PROGRESS",
    "PROOF_CLOSURE_PROGRESS",
    "PRODUCT_ACCEPTANCE_PROGRESS",
    "USER_ACCEPTANCE_STATUS"
  ],
  "orchestrator": {
    "design": "deterministic_controller_with_ai_semantic_adjudication",
    "ai_role": [
      "semantic_adjudication",
      "root_cause_analysis",
      "read_only_investigation",
      "repair_design",
      "structured_recommendations"
    ],
    "ai_direct_unrestricted_shell": false,
    "ai_direct_git_mutation": false,
    "api_key_source": "OPENAI_API_KEY environment variable only",
    "api_key_must_never_be_logged_or_versioned": true,
    "state_root": "~/.local/state/mppg-orchestrator",
    "runtime_root": "~/.local/share/mppg-orchestrator",
    "mandatory_acceptance_guard": true,
    "front_class_enum_validation": true,
    "acceptance_derivation_must_precede_staging": true,
    "closure_decision_must_be_computed_not_hardcoded": true,
    "forbid_hardcoded_user_acceptance_not_applicable": true,
    "forbid_hardcoded_front_closed_true": true,
    "permanent_command": "mppg-orchestrator run",
    "canonical_source": "governance/orchestrator/",
    "runtime_copy": "~/.local/share/mppg-orchestrator/runtime/",
    "launcher": "~/.local/bin/mppg-orchestrator",
    "openai_protocol": {
      "api": "Responses API",
      "endpoint": "https://api.openai.com/v1/responses",
      "model_default": "gpt-5.6-luna",
      "key_source": "OPENAI_API_KEY process environment only",
      "strict_function_schemas": true,
      "strict_final_structured_output": true,
      "parallel_tool_calls": false,
      "store": false,
      "unrestricted_shell": false,
      "direct_git_mutation_by_ai": false
    },
    "autoresolve": {
      "enabled": true,
      "allowed_automatic_actions": [
        "NOOP",
        "RERUN_READONLY_PROBE",
        "RECLASSIFY_FROM_EVIDENCE",
        "REBUILD_EPHEMERAL_AUDITOR",
        "RECOMPUTE_EPHEMERAL_EVIDENCE",
        "RETRY_EXTERNAL_READONLY",
        "SIMULATE_PATCH_IN_SHADOW"
      ],
      "canonical_mutation_requires_authorization": true,
      "user_acceptance_never_auto_pass": true,
      "harness_consecutive_defect_limit": 2
    },
    "harness_safety": {
      "host_interactive_shell_option_mutation": "PROHIBITED",
      "shell_strict_mode": "SUBPROCESS_OR_SUBSHELL_ONLY",
      "source_user_profile_in_parent_shell": "PROHIBITED",
      "profile_validation": "CHILD_SHELL_ONLY"
    }
  },
  "front_class_contract": {
    "allowed_values": [
      "functional",
      "structural",
      "documentation",
      "dependency",
      "runtime",
      "persistent_data",
      "security_access",
      "mixed",
      "other"
    ],
    "unknown_value_policy": "block_fail_closed",
    "governance_front_recommendation": "mixed"
  }
}
