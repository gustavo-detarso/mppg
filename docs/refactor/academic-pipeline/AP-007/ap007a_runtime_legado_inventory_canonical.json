{
  "architectural_decision": {
    "closure_criteria": [
      "cli.main não depende de run_legacy no caminho público normal",
      "parser e handlers recebem argv explicitamente",
      "nenhum dispatch público altera sys.argv",
      "nenhum dispatch público insere caminho em sys.path",
      "nenhum dispatch público importa academic_pipeline_rc10",
      "globals()/locals() não são usados como container de dependências do runtime público",
      "console instalado e python -m academic_pipeline apresentam paridade funcional",
      "wheel funciona fora do checkout e sem PYTHONPATH herdado",
      "comandos gerados pelo wizard usam o entrypoint público",
      "scripts auxiliares não reentram pelo monólito histórico",
      "run_legacy é removido ou reduzido a fallback residual explicitamente enumerado"
