\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fgv-dissertacao}[2026/05/04 v1.1 Estilo de dissertacao baseado no modelo 2025 sem biblatex fixo]

% ============================================================
%  COMPILACAO
% ============================================================
\RequirePackage{ifluatex}
\ifluatex\else
  \PackageError{fgv-dissertacao}{Este pacote exige compilacao com LuaLaTeX}{Use lualatex como compilador}
\fi

% ============================================================
%  IDIOMA / FONTE / MICROTIPOGRAFIA
% ============================================================
\RequirePackage[brazil]{babel}
\RequirePackage{fontspec}
\RequirePackage{microtype}
\defaultfontfeatures{Ligatures=TeX}

% Tenta Times New Roman; se nao existir, usa TeX Gyre Termes.
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\setmainfont{TeX Gyre Termes}}

\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}

% ============================================================
%  GEOMETRIA / PAGINA
%  Modelo Word analisado:
%  - superior: 3,0 cm
%  - esquerda: 3,0 cm
%  - inferior: 2,0 cm
%  - direita: 2,0 cm
% ============================================================
\RequirePackage[a4paper,left=3cm,right=2cm,top=3cm,bottom=2cm,headheight=14pt]{geometry}
\RequirePackage{fancyhdr}
\pagestyle{plain}

% ============================================================
%  ESPACAMENTO / PARAGRAFO
%  Modelo Word analisado:
%  - fonte 12 pt
%  - entrelinhas 1,5
%  - recuo da primeira linha ~ 1,25 cm
%  - sem espaco extra entre paragrafos
% ============================================================
\RequirePackage{setspace}
\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\emergencystretch=2em

% ============================================================
%  JUSTIFICACAO E HIFENIZACAO
% ============================================================
\RequirePackage{ragged2e}
\justifying
\hyphenpenalty=500
\exhyphenpenalty=50

% ============================================================
%  TITULOS
%  Aproximacao do modelo observado:
%  - nivel 1: negrito, caixa alta
%  - nivel 2: negrito
%  - nivel 3: negrito italico
% ============================================================
\RequirePackage{titlesec}

% Capitulo: centralizado, negrito, caixa alta
\titleformat{\chapter}[display]
  {\normalfont\bfseries\centering}
  {\chaptertitlename\ \thechapter}
  {1ex}
  {\MakeUppercase}

\titlespacing*{\chapter}{0pt}{0pt}{24pt}

% Secao
\titleformat{\section}
  {\normalfont\bfseries}
  {\thesection}
  {0.75em}
  {}
\titlespacing*{\section}{0pt}{12pt}{12pt}

% Subsecao
\titleformat{\subsection}
  {\normalfont\bfseries}
  {\thesubsection}
  {0.75em}
  {}
\titlespacing*{\subsection}{0pt}{12pt}{12pt}

% Subsubsecao
\titleformat{\subsubsection}
  {\normalfont\bfseries\itshape}
  {\thesubsubsection}
  {0.75em}
  {}
\titlespacing*{\subsubsection}{0pt}{12pt}{12pt}

% Paragrafo
\titleformat{\paragraph}[runin]
  {\normalfont\bfseries}
  {\theparagraph}
  {0.5em}
  {}
\titlespacing*{\paragraph}{0pt}{12pt}{0.75em}

\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}

% ============================================================
%  LISTAS NUMERADAS HIERARQUICAS
% ============================================================
\RequirePackage{enumitem}
\setlist[itemize]{topsep=0.4\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\setlist[enumerate]{topsep=0.4\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\setlist[enumerate,1]{label=\arabic*.,leftmargin=1.5cm}
\setlist[enumerate,2]{label=\arabic{enumi}.\arabic*.,leftmargin=1.7cm}
\setlist[enumerate,3]{label=\arabic{enumi}.\arabic{enumii}.\arabic*.,leftmargin=2cm}

% ============================================================
%  SUMARIO / LISTAS
% ============================================================
\RequirePackage{tocloft}
\renewcommand{\contentsname}{SUMÁRIO}
\renewcommand{\listfigurename}{LISTA DE ILUSTRAÇÕES}
\renewcommand{\listtablename}{LISTA DE TABELAS}
\renewcommand{\cfttoctitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftafterlottitle}{\hfill}

\setlength{\cftbeforechapskip}{0.2em}
\setlength{\cftbeforesecskip}{0em}
\setlength{\cftchapnumwidth}{2.8em}
\setlength{\cftsecnumwidth}{3.6em}
\setlength{\cftsubsecnumwidth}{4.5em}
\setlength{\cftsubsubsecnumwidth}{5.5em}

% ============================================================
%  LEGENDAS / TABELAS / FIGURAS
%  Aproximacao do modelo:
%  - titulo centralizado
%  - fonte/nota em tamanho menor e espaco simples
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{caption}

\captionsetup{
  font={small,stretch=1},
  labelfont=bf,
  textfont=normalfont,
  labelsep=endash,
  justification=centering,
  singlelinecheck=false,
  skip=6pt
}

\newcommand{\fonte}[1]{%
  \par\vspace{3pt}%
  {\singlespacing\footnotesize\noindent\textbf{Fonte:} #1\par}%
}

\newcommand{\notaexplicativa}[1]{%
  {\singlespacing\footnotesize\noindent\textbf{Nota:} #1\par}%
}

% ============================================================
%  CITACOES E REFERENCIAS
% ============================================================
\RequirePackage{csquotes}

% O biblatex deve ser carregado pelo Org/pipeline, via #+CITE_EXPORT,
% para permitir APA, ABNT ou outro estilo conforme o TOML.
% Não carregue \RequirePackage{biblatex} aqui, pois isso conflita com
% opções geradas dinamicamente pelo exportador Org/LaTeX.

% ============================================================
%  NOTAS DE RODAPE
% ============================================================
\RequirePackage[bottom]{footmisc}
\renewcommand{\footnoterule}{%
  \kern -3pt
  \hrule width 0.3\textwidth
  \kern 2.6pt
}
\setlength{\footnotesep}{0.4cm}

% ============================================================
%  ESPACAMENTO ESPECIFICO DE ELEMENTOS ACADEMICOS
% ============================================================
\newenvironment{citacaolonga}
  {\begin{quote}\singlespacing\footnotesize}
  {\end{quote}}

\newenvironment{resumoacademico}
  {\begin{spacing}{1}\noindent}
  {\par\end{spacing}}

\newenvironment{referenciasacademicas}
  {\begin{spacing}{1}\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}}
  {\end{spacing}}

% ============================================================
%  METADADOS DO TRABALHO
% ============================================================
