  \begin{spacing}{1.5}
  \itshape
}{%
  \end{spacing}
  \end{minipage}
  \end{flushright}
}

\newenvironment{epigrafe}{%
  \clearpage
  \thispagestyle{empty}
  \vspace*{0.35\textheight}
  \begin{flushright}
  \begin{minipage}{0.5\textwidth}
  \begin{spacing}{1.5}
  \itshape
}{%
  \end{spacing}
  \end{minipage}
  \end{flushright}
}

\newenvironment{agradecimentos}{%
  \chapter*{AGRADECIMENTOS}
  \addcontentsline{toc}{chapter}{AGRADECIMENTOS}
}{%
}

\newenvironment{resumo}{%
  \chapter*{RESUMO}
  \addcontentsline{toc}{chapter}{RESUMO}
  \begin{resumoacademico}
}{%
  \par
  \ifstrempty{\FGVpalavraschave}{}{\vspace{\baselineskip}\noindent\textbf{Palavras-chave:} \FGVpalavraschave.}
  \end{resumoacademico}
}

\newenvironment{abstractacademico}{%
  \chapter*{ABSTRACT}
  \addcontentsline{toc}{chapter}{ABSTRACT}
  \begin{resumoacademico}
}{%
  \par
  \ifstrempty{\FGVkeywords}{}{\vspace{\baselineskip}\noindent\textbf{Keywords:} \FGVkeywords.}
  \end{resumoacademico}
}

