\newif\ifpapercover
\papercoverfalse
\newcommand{\usepapercover}{\papercovertrue}
\newcommand{\disablepapercover}{\papercoverfalse}

\makeatletter
\def\paper@institution{}
\def\paper@program{}
\def\paper@course{}
\def\paper@discipline{}
\def\paper@professor{}
\def\paper@city{}
\def\paper@papertype{Paper acadêmico}
\def\paper@covernote{}
\def\paper@coauthor{}

\newcommand{\institution}[1]{\gdef\paper@institution{#1}}
\newcommand{\programname}[1]{\gdef\paper@program{#1}}
\newcommand{\coursename}[1]{\gdef\paper@course{#1}}
\newcommand{\disciplinename}[1]{\gdef\paper@discipline{#1}}
\newcommand{\professorname}[1]{\gdef\paper@professor{#1}}
\newcommand{\cityname}[1]{\gdef\paper@city{#1}}
\newcommand{\papertype}[1]{\gdef\paper@papertype{#1}}
\newcommand{\covernote}[1]{\gdef\paper@covernote{#1}}
\newcommand{\coauthor}[1]{\gdef\paper@coauthor{#1}}

\newcommand{\makepapercover}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      \setstretch{1.15}
      {\normalsize
      \ifstrempty{\paper@institution}{}{\paper@institution\par}
      \vspace{0.6\baselineskip}
      \ifstrempty{\paper@program}{}{\paper@program\par}
      \ifstrempty{\paper@course}{}{\paper@course\par}
      \ifstrempty{\paper@discipline}{}{\vspace{0.3\baselineskip}\paper@discipline\par}
      }

      \vfill

      {\bfseries\normalsize \thetitle\par}

      \vspace{2.4\baselineskip}

      {\normalsize \theauthor\par}
      \ifstrempty{\paper@coauthor}{}{\vspace{0.6\baselineskip}{\normalsize \paper@coauthor\par}}

      \vfill

      \begin{flushright}
      \begin{minipage}{0.52\textwidth}
      \setstretch{1.1}
      \noindent
      \paper@papertype.
      \ifstrempty{\paper@covernote}{}{\space \paper@covernote}
      \ifstrempty{\paper@professor}{}{\\[1.0\baselineskip]Professor: \paper@professor}
      \end{minipage}
      \end{flushright}

      \vfill

      {\normalsize
      \ifstrempty{\paper@city}{}{\paper@city\par}
      \vspace{0.2\baselineskip}
      \the\year
      \par}
    \end{center}
  \end{titlepage}
  \setcounter{page}{1}
}
\makeatother

\newcommand{\makemytitle}{%
  \ifpapercover
    \makepapercover
  \else
    \maketitle
  \fi
}

