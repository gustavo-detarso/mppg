\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fgv-dissertacao}[2026/04/21 v2.1 Estilo de dissertação FGV]

% ============================================================
%  COMPILACAO
% ============================================================
\RequirePackage{ifluatex}
\ifluatex\else
  \PackageError{fgv-dissertacao}{Este pacote exige compilacao com LuaLaTeX}{Use lualatex como compilador}
\fi

% ============================================================
%  IDIOMA / FONTE / MICROTIPOGRAFIA
% ============================================================
\RequirePackage[brazil]{babel}
\RequirePackage{fontspec}
\RequirePackage{microtype}
\defaultfontfeatures{Ligatures=TeX}

\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\setmainfont{TeX Gyre Termes}}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}

% ============================================================
%  PAGINA / MARGENS (FGV 2025)
% ============================================================
\RequirePackage[a4paper,left=3cm,right=2cm,top=3cm,bottom=2cm,headheight=14pt]{geometry}
\RequirePackage{fancyhdr}
\fancypagestyle{fgvbody}{
  \fancyhf{}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
\pagestyle{empty}

% ============================================================
%  PARAGRAFO / ESPACAMENTO
% ============================================================
\RequirePackage{setspace}
\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

% ============================================================
%  JUSTIFICACAO
% ============================================================
\RequirePackage{ragged2e}
\justifying
\emergencystretch=2em

% ============================================================
%  TITULOS (SECOES, NAO CAPITULOS)
% ============================================================
\RequirePackage{titlesec}
\RequirePackage{etoolbox}

\titleformat{\section}
  {\normalfont\bfseries\MakeUppercase}
  {\thesection}
  {0.75em}
  {}
\titlespacing*{\section}{0pt}{18pt}{18pt}

\titleformat{\subsection}
  {\normalfont\bfseries}
  {\thesubsection}
  {0.75em}
  {}
\titlespacing*{\subsection}{0pt}{18pt}{18pt}

\titleformat{\subsubsection}
  {\normalfont\bfseries\itshape}
  {\thesubsubsection}
  {0.75em}
  {}
\titlespacing*{\subsubsection}{0pt}{18pt}{18pt}

\titleformat{\paragraph}
  {\normalfont}
  {\theparagraph}
  {0.5em}
  {}
\titlespacing*{\paragraph}{0pt}{18pt}{18pt}

\titleformat{\subparagraph}
  {\normalfont\itshape}
  {\thesubparagraph}
  {0.5em}
  {}
\titlespacing*{\subparagraph}{0pt}{18pt}{18pt}

% Titulos sem numeracao
\titleformat{name=\section,numberless}
  {\normalfont\bfseries\centering\MakeUppercase}
  {}
  {0pt}
  {}
\titlespacing*{name=\section,numberless}{0pt}{0pt}{18pt}

% Secoes primarias iniciam em nova pagina
\pretocmd{\section}{\clearpage}{}{}

\setcounter{secnumdepth}{5}
\setcounter{tocdepth}{5}

% ============================================================
%  LISTAS
% ============================================================
\RequirePackage{enumitem}
\setlist[itemize]{topsep=0.4\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\setlist[enumerate]{topsep=0.4\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}

% ============================================================
%  SUMARIO / LISTAS
% ============================================================
\RequirePackage{tocloft}
\renewcommand{\contentsname}{SUMÁRIO}
\renewcommand{\listfigurename}{LISTA DE ILUSTRAÇÕES}
\renewcommand{\listtablename}{LISTA DE TABELAS}
\renewcommand{\cfttoctitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\normalfont\bfseries\MakeUppercase}
\renewcommand{\cftafterlottitle}{\hfill}

% ============================================================
%  TABELAS / FIGURAS
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{caption}

\captionsetup{
  font={small,stretch=1},
  labelfont=bf,
  textfont=normalfont,
  labelsep=endash,
  justification=centering,
  singlelinecheck=false,
  skip=6pt
}

\newcommand{\fonte}[1]{%
  \par\vspace{3pt}%
  {\singlespacing\footnotesize\noindent\textbf{Fonte:} #1\par}%
}

\newcommand{\notaexplicativa}[1]{%
  {\singlespacing\footnotesize\noindent\textbf{Nota:} #1\par}%
}

% ============================================================
%  NOTAS DE RODAPE
% ============================================================
\RequirePackage[bottom]{footmisc}
\renewcommand{\footnoterule}{%
  \kern -3pt
  \hrule width 0.3\textwidth
  \kern 2.6pt
}
\setlength{\footnotesep}{0.4cm}

% ============================================================
%  METADADOS
% ============================================================
\newcommand{\autor}[1]{\gdef\FGVautor{#1}}
\newcommand{\titulo}[1]{\gdef\FGVtitulo{#1}}
\newcommand{\subtitulo}[1]{\gdef\FGVsubtitulo{#1}}
\newcommand{\cidade}[1]{\gdef\FGVcidade{#1}}
\newcommand{\ano}[1]{\gdef\FGVano{#1}}
\newcommand{\instituicao}[1]{\gdef\FGVinstituicao{#1}}
\newcommand{\escola}[1]{\gdef\FGVescola{#1}}
\newcommand{\programa}[1]{\gdef\FGVprograma{#1}}
\newcommand{\curso}[1]{\gdef\FGVcurso{#1}}
\newcommand{\areadeconcentracao}[1]{\gdef\FGVareadeconcentracao{#1}}
\newcommand{\linhapesquisa}[1]{\gdef\FGVlinhapesquisa{#1}}
\newcommand{\orientador}[1]{\gdef\FGVorientador{#1}}
\newcommand{\coorientador}[1]{\gdef\FGVcoorientador{#1}}
\newcommand{\naturezatrabalho}[1]{\gdef\FGVnaturezatrabalho{#1}}
\newcommand{\membrobancaum}[1]{\gdef\FGVmembrobancaum{#1}}
\newcommand{\membrobancadois}[1]{\gdef\FGVmembrobancadois{#1}}
\newcommand{\membrobancatres}[1]{\gdef\FGVmembrobancatres{#1}}
\newcommand{\dataaprovacao}[1]{\gdef\FGVdataaprovacao{#1}}

\autor{}
\titulo{}
\subtitulo{}
\cidade{}
\ano{}
\instituicao{FUNDAÇÃO GETULIO VARGAS}
\escola{}
\programa{}
\curso{}
\areadeconcentracao{}
\linhapesquisa{}
\orientador{}
\coorientador{}
\naturezatrabalho{Dissertação apresentada como requisito para obtenção do título correspondente.}
\membrobancaum{}
\membrobancadois{}
\membrobancatres{}
\dataaprovacao{}

\newcommand{\FGVtituloCompleto}{%
  \FGVtitulo\ifstrempty{\FGVsubtitulo}{}{\,: \FGVsubtitulo}%
}

% ============================================================
%  CAPA / FOLHA DE ROSTO / APROVACAO
% ============================================================
\newcommand{\capa}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      {\large \MakeUppercase{\FGVinstituicao}\par}
      \ifstrempty{\FGVescola}{}{\vspace{0.5\baselineskip}{\large \MakeUppercase{\FGVescola}\par}}
      \ifstrempty{\FGVprograma}{}{\vspace{0.5\baselineskip}{\large \MakeUppercase{\FGVprograma}\par}}
      \vfill
      {\large \MakeUppercase{\FGVautor}\par}
      \vfill
      {\large\bfseries \MakeUppercase{\FGVtituloCompleto}\par}
      \vfill
      {\large \FGVcidade\par}
      {\large \FGVano\par}
    \end{center}
  \end{titlepage}
  \setcounter{page}{0}
}

\newcommand{\folhaderosto}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      {\large \MakeUppercase{\FGVautor}\par}
      \vfill
      {\large\bfseries \MakeUppercase{\FGVtituloCompleto}\par}
    \end{center}

    \vspace{2cm}
    \hfill
    \begin{minipage}{0.50\textwidth}
      \begin{spacing}{1}
      \justifying
      \FGVnaturezatrabalho
      \ifstrempty{\FGVcurso}{}{\\[0.8\baselineskip]\textbf{Curso:} \FGVcurso}
      \ifstrempty{\FGVareadeconcentracao}{}{\\[0.8\baselineskip]\textbf{Área de concentração:} \FGVareadeconcentracao}
      \ifstrempty{\FGVlinhapesquisa}{}{\\[0.8\baselineskip]\textbf{Linha de pesquisa:} \FGVlinhapesquisa}
      \ifstrempty{\FGVorientador}{}{\\[0.8\baselineskip]\textbf{Orientador:} \FGVorientador}
      \ifstrempty{\FGVcoorientador}{}{\\[0.8\baselineskip]\textbf{Coorientador:} \FGVcoorientador}
      \end{spacing}
    \end{minipage}

    \vfill
    \begin{center}
      {\large \FGVcidade\par}
      {\large \FGVano\par}
    \end{center}
  \end{titlepage}
}

\newcommand{\folhadeaprovacao}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      {\large \MakeUppercase{\FGVautor}\par}
      \vspace{2\baselineskip}
      {\large\bfseries \MakeUppercase{\FGVtituloCompleto}\par}
    \end{center}

    \vspace{2\baselineskip}
    \hfill
    \begin{minipage}{0.50\textwidth}
      \begin{spacing}{1}
      \justifying
      \FGVnaturezatrabalho
      \ifstrempty{\FGVareadeconcentracao}{}{\\[0.8\baselineskip]\textbf{Área de concentração:} \FGVareadeconcentracao}
      \end{spacing}
    \end{minipage}

    \vspace{1.5\baselineskip}
    \noindent\textbf{Data de aprovação:} \FGVdataaprovacao

    \vspace{2\baselineskip}
    \noindent\textbf{Banca examinadora:}

    \vspace{2\baselineskip}
    \noindent\rule{\textwidth}{0.4pt}
    \ifstrempty{\FGVorientador}{\noindent Prof. Dr. (Orientador) [Inserir nome completo]}{\noindent \FGVorientador}

    \vspace{2\baselineskip}
    \noindent\rule{\textwidth}{0.4pt}
    \ifstrempty{\FGVmembrobancaum}{\noindent Prof. Dr. [Inserir nome completo]}{\noindent \FGVmembrobancaum}

    \vspace{2\baselineskip}
    \noindent\rule{\textwidth}{0.4pt}
    \ifstrempty{\FGVmembrobancadois}{\noindent Prof. Dr. [Inserir nome completo]}{\noindent \FGVmembrobancadois}

    \ifstrempty{\FGVmembrobancatres}{}{%
      \vspace{2\baselineskip}
      \noindent\rule{\textwidth}{0.4pt}
      \noindent \FGVmembrobancatres
    }

    \vfill
    \begin{center}
      {\large \FGVcidade\par}
      {\large \FGVano\par}
    \end{center}
  \end{titlepage}
}

\newcommand{\fichacatalograficaaviso}{%
  \clearpage
  \thispagestyle{empty}
  \vspace*{\fill}
  \begin{center}
  Inserir a ficha catalográfica na versão final do PDF, conforme orientação da Biblioteca da FGV.
  \end{center}
  \vspace*{\fill}
}

\newcommand{\elementostextuais}{%
  \clearpage
  \pagestyle{fgvbody}
}

\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
